<!--
  Two-slice variant of s1_grd_beta0_tc.xml. The selected descending acquisition
  (2024-08-06, datatake 06B64D) is two consecutive GRD slices. Thermal noise is
  removed per slice (SNAP refuses noise removal after slice assembly), then
  SliceAssembly joins them and the orbit is applied, so the terrain correction
  sees one continuous product. Calibration and terrain correction are identical
  to the one-slice graph.

  Run:
    gpt validation/snap/s1_grd_beta0_tc_2slices.xml \
        -Pinput1=data/raw/S1A_IW_GRDH_1SDV_20240806T053519_20240806T053544_055088_06B64D_2F40.zip \
        -Pinput2=data/raw/S1A_IW_GRDH_1SDV_20240806T053544_20240806T053609_055088_06B64D_8ECE.zip \
        -Pdem=build/validation/region_dem.tif \
        -Poutput=build/validation/snap_descending.tif

  STATUS: run with SNAP 14.0 on the 2024-08-06 descending slices, one
  calibration block only (validation/snap_check.py); same output format as the
  one-slice graph. The join was checked on block 7.2-7.4 E, 46.8-47.0 N, which
  the seam crosses at 46.90 N: no gap, and the joined product matches each
  slice processed alone (mean bias under 0.1 dB at 90 m).
-->
<graph id="s1_grd_beta0_tc_2slices">
  <version>1.0</version>
  <node id="Read1">
    <operator>Read</operator>
    <parameters>
      <file>${input1}</file>
    </parameters>
  </node>
  <node id="Read2">
    <operator>Read</operator>
    <parameters>
      <file>${input2}</file>
    </parameters>
  </node>
  <node id="ThermalNoiseRemoval1">
    <operator>ThermalNoiseRemoval</operator>
    <sources>
      <sourceProduct refid="Read1"/>
    </sources>
    <parameters>
      <selectedPolarisations>VV</selectedPolarisations>
      <removeThermalNoise>true</removeThermalNoise>
    </parameters>
  </node>
  <node id="ThermalNoiseRemoval2">
    <operator>ThermalNoiseRemoval</operator>
    <sources>
      <sourceProduct refid="Read2"/>
    </sources>
    <parameters>
      <selectedPolarisations>VV</selectedPolarisations>
      <removeThermalNoise>true</removeThermalNoise>
    </parameters>
  </node>
  <node id="SliceAssembly">
    <operator>SliceAssembly</operator>
    <sources>
      <sourceProduct refid="ThermalNoiseRemoval1"/>
      <sourceProduct.1 refid="ThermalNoiseRemoval2"/>
    </sources>
    <parameters>
      <selectedPolarisations>VV</selectedPolarisations>
    </parameters>
  </node>
  <node id="Apply-Orbit-File">
    <operator>Apply-Orbit-File</operator>
    <sources>
      <sourceProduct refid="SliceAssembly"/>
    </sources>
    <parameters>
      <orbitType>Sentinel Precise (Auto Download)</orbitType>
      <continueOnFail>false</continueOnFail>
    </parameters>
  </node>
  <node id="Calibration">
    <operator>Calibration</operator>
    <sources>
      <sourceProduct refid="Apply-Orbit-File"/>
    </sources>
    <parameters>
      <selectedPolarisations>VV</selectedPolarisations>
      <outputSigmaBand>false</outputSigmaBand>
      <outputBetaBand>true</outputBetaBand>
      <outputGammaBand>false</outputGammaBand>
    </parameters>
  </node>
  <node id="Terrain-Correction">
    <operator>Terrain-Correction</operator>
    <sources>
      <sourceProduct refid="Calibration"/>
    </sources>
    <parameters>
      <demName>External DEM</demName>
      <externalDEMFile>${dem}</externalDEMFile>
      <externalDEMNoDataValue>-9999.0</externalDEMNoDataValue>
      <externalDEMApplyEGM>false</externalDEMApplyEGM>
      <demResamplingMethod>BILINEAR_INTERPOLATION</demResamplingMethod>
      <imgResamplingMethod>BILINEAR_INTERPOLATION</imgResamplingMethod>
      <pixelSpacingInMeter>30.0</pixelSpacingInMeter>
      <mapProjection>EPSG:32632</mapProjection>
      <nodataValueAtSea>false</nodataValueAtSea>
      <saveSelectedSourceBand>true</saveSelectedSourceBand>
      <saveLayoverShadowMask>true</saveLayoverShadowMask>
      <applyRadiometricNormalization>false</applyRadiometricNormalization>
    </parameters>
  </node>
  <node id="Write">
    <operator>Write</operator>
    <sources>
      <sourceProduct refid="Terrain-Correction"/>
    </sources>
    <parameters>
      <file>${output}</file>
      <formatName>GeoTIFF-BigTIFF</formatName>
    </parameters>
  </node>
</graph>
